    {
      "name": "5. PDF - Upload & Documents",
      "item": [
        {
          "name": "Upload PDF",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has documentId, documentName, chunks', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('documentId');",
                  "  pm.expect(body).to.have.property('documentName');",
                  "  pm.expect(body).to.have.property('chunks');",
                  "  pm.collectionVariables.set('pdfDocumentId', body.documentId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": [] }]
            },
            "url": { "raw": "{{baseUrl}}/api/pdf/upload", "host": ["{{baseUrl}}"], "path": ["api", "pdf", "upload"] },
            "description": "Attach a PDF file in the 'file' form field (click 'Select Files' — src is left blank for portability). On success, the test script saves documentId into the {{pdfDocumentId}} collection variable for use by 'Retrieve PDF - Filtered by Document' below."
          },
          "response": []
        },
        {
          "name": "Upload PDF - Validation Error (missing file)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error mentions file', () => {",
                  "  pm.expect(pm.response.json().error).to.include('file');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "formdata", "formdata": [] },
            "url": { "raw": "{{baseUrl}}/api/pdf/upload", "host": ["{{baseUrl}}"], "path": ["api", "pdf", "upload"] },
            "description": "Send with no 'file' field attached. Expects 400 with { error: \"`file` is required\" }."
          },
          "response": []
        },
        {
          "name": "Upload PDF - Validation Error (non-PDF file)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error mentions PDF', () => {",
                  "  pm.expect(pm.response.json().error).to.include('PDF');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": [] }]
            },
            "url": { "raw": "{{baseUrl}}/api/pdf/upload", "host": ["{{baseUrl}}"], "path": ["api", "pdf", "upload"] },
            "description": "Attach a non-PDF file (e.g. a .txt or .png) to the 'file' field to trigger multer's fileFilter rejection. Expects 400 with { error: \"Only PDF files are supported\" }."
          },
          "response": []
        },
        {
          "name": "List Uploaded PDF Documents",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns documents array', () => {",
                  "  pm.expect(pm.response.json().documents).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/pdf/documents", "host": ["{{baseUrl}}"], "path": ["api", "pdf", "documents"] },
            "description": "Lists every uploaded PDF grouped by document, with chunk counts and upload timestamps."
          },
          "response": []
        }
      ]
    },
