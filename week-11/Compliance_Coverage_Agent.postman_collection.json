{
  "info": {
    "name": "Compliance Coverage Agent",
    "description": "Full API collection for the Compliance Coverage Agent backend: health, GDPR/EU AI Act scrape + ingest + hybrid retrieval, custom PDF upload + hybrid retrieval, and the .env/logo Settings API. Each folder includes success and validation-error sample requests. Pair with the 'Compliance Coverage Agent' environment (sets baseUrl to your running backend port).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "pdfDocumentId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body is { status: \"ok\" }', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. Scrape",
      "item": [
        {
          "name": "Scrape GDPR",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has count and file', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('count');",
                  "  pm.expect(body).to.have.property('file');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/scrape/gdpr", "host": ["{{baseUrl}}"], "path": ["api", "scrape", "gdpr"] },
            "description": "Scrapes https://gdpr-info.eu/ (Articles 1-99) and writes backend/data/gdpr_clauses_langchain.json. Takes a few minutes (polite 1s delay between requests). No request body."
          },
          "response": []
        },
        {
          "name": "Scrape EU AI Act",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has count and file', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('count');",
                  "  pm.expect(body).to.have.property('file');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/scrape/eu-ai-act", "host": ["{{baseUrl}}"], "path": ["api", "scrape", "eu-ai-act"] },
            "description": "Scrapes https://artificialintelligenceact.eu/ (Articles 1-113) and writes backend/data/eu_ai_act_clauses_langchain.json. Takes a few minutes (polite 1s delay between requests). No request body."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Ingest",
      "item": [
        {
          "name": "Ingest GDPR",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has inserted and updated', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('inserted');",
                  "  pm.expect(body).to.have.property('updated');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/ingest/gdpr", "host": ["{{baseUrl}}"], "path": ["api", "ingest", "gdpr"] },
            "description": "Embeds (Mistral) and upserts (by clauseId) gdpr_clauses_langchain.json into MongoDB Atlas. Requires Scrape GDPR to have run first. Returns { inserted, updated }."
          },
          "response": []
        },
        {
          "name": "Ingest EU AI Act",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has inserted and updated', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('inserted');",
                  "  pm.expect(body).to.have.property('updated');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/ingest/eu-ai-act", "host": ["{{baseUrl}}"], "path": ["api", "ingest", "eu-ai-act"] },
            "description": "Embeds (Mistral) and upserts (by clauseId) eu_ai_act_clauses_langchain.json into MongoDB Atlas. Requires Scrape EU AI Act to have run first. Returns { inserted, updated }."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Retrieve - GDPR",
      "item": [
        {
          "name": "Retrieve GDPR - Hybrid Search (default)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Top match is Art. 17 GDPR', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.matches[0].clauseId).to.eql('Art. 17 GDPR');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"story\": \"User can request full deletion of their account and data\",\n  \"topK\": 5\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/retrieve/gdpr", "host": ["{{baseUrl}}"], "path": ["api", "retrieve", "gdpr"] },
            "description": "Vector search + keyword ($text) search fused via RRF, then Groq rerank. useHybridSearch omitted => defaults to true. Expects Art. 17 GDPR (Right to erasure) as top match."
          },
          "response": []
        },
        {
          "name": "Retrieve GDPR - Vector Only (hybrid disabled)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns matches array', () => {",
                  "  pm.expect(pm.response.json().matches).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"story\": \"User can request full deletion of their account and data\",\n  \"topK\": 5,\n  \"useHybridSearch\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/retrieve/gdpr", "host": ["{{baseUrl}}"], "path": ["api", "retrieve", "gdpr"] },
            "description": "Same query with useHybridSearch explicitly false — compare ranking against the hybrid request above."
          },
          "response": []
        },
        {
          "name": "Retrieve GDPR - Validation Error (missing story)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error mentions story', () => {",
                  "  pm.expect(pm.response.json().error).to.include('story');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/retrieve/gdpr", "host": ["{{baseUrl}}"], "path": ["api", "retrieve", "gdpr"] },
            "description": "Expects 400 with { error: \"`story` is required and must be a non-empty string\" }."
          },
          "response": []
        },
        {
          "name": "Retrieve GDPR - Validation Error (invalid topK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error mentions topK', () => {",
                  "  pm.expect(pm.response.json().error).to.include('topK');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"story\": \"User can request full deletion of their account and data\",\n  \"topK\": -1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/retrieve/gdpr", "host": ["{{baseUrl}}"], "path": ["api", "retrieve", "gdpr"] },
            "description": "topK must be a positive number. Expects 400 with { error: \"`topK` must be a positive number\" }."
          },
          "response": []
        },
        {
          "name": "Retrieve GDPR - Validation Error (invalid useHybridSearch type)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error mentions useHybridSearch', () => {",
                  "  pm.expect(pm.response.json().error).to.include('useHybridSearch');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"story\": \"User can request full deletion of their account and data\",\n  \"useHybridSearch\": \"yes\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/retrieve/gdpr", "host": ["{{baseUrl}}"], "path": ["api", "retrieve", "gdpr"] },
            "description": "useHybridSearch must be a boolean, not a string. Expects 400 with { error: \"`useHybridSearch` must be a boolean\" }."
          },
          "response": []
        }
      ]
    },
