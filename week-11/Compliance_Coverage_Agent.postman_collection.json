    {
      "name": "7. Settings - Env Config",
      "item": [
        {
          "name": "Get Settings",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Secrets are masked (no raw values)', () => {",
                  "  const body = pm.response.json();",
                  "  const secretFields = body.settings.filter(f => f.type === 'secret');",
                  "  pm.expect(secretFields.length).to.be.greaterThan(0);",
                  "  secretFields.forEach(f => pm.expect(f.value).to.eql(''));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/settings", "host": ["{{baseUrl}}"], "path": ["api", "settings"] },
            "description": "Returns every configurable .env field. Secret fields (MONGODB_URI, MISTRAL_API_KEY, GROQ_API_KEY) always come back with value: \"\" — only isSet indicates whether one is configured."
          },
          "response": []
        },
        {
          "name": "Update Settings - Non-secret field (TOP_K)",
          "event": [
