              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "rerank"
              ]
            },
            "description": "Takes a query and a list of texts and produces an ordered array with each text assigned a relevance score. See https://docs.cohere.com/reference/rerank",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"rerank-v4.0-pro\",\n  \"query\": \"What is the capital of the United States?\",\n  \"documents\": [\n    \"Carson City is the capital city of the American state of Nevada.\",\n    \"The Commonwealth of the Northern Mariana Islands is a group of islands in the Pacific Ocean. Its capital is Saipan.\",\n    \"Capitalization or capitalisation in English grammar is the use of a capital letter at the start of a word.\",\n    \"Washington, D.C. is the capital of the United States. It is a federal district.\",\n    \"Capital punishment has existed in the United States since before the United States was a country.\"\n  ],\n  \"top_n\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
